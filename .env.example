# Agent Assurance Laboratory — Safe Environment Template
# NEVER commit real credentials, service account keys, or tokens to git.

# Environment configuration: development | staging | production
ENVIRONMENT=development

# Authentication bypass: true for local dev ONLY; strictly forbidden in production
AUTH_DISABLED=true

# Server port
PORT=8000

# Optional Firebase / Identity Platform credentials (production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# FIREBASE_PROJECT_ID=your-project-id

# Google Cloud Storage Buckets (production)
# GCS_FIXTURES_BUCKET=agent-assurance-prod-fixtures
# GCS_STATE_BUCKET=agent-assurance-prod-state
# GCS_EVIDENCE_BUCKET=agent-assurance-prod-evidence
# GCS_REPORTS_BUCKET=agent-assurance-prod-reports

# BigQuery Dataset (production)
# BQ_DATASET_ID=agent_assurance_prod

# Cloud Tasks Queue (production)
# CLOUD_TASKS_QUEUE=projects/your-project/locations/europe-west2/queues/assurance-run-queue

# Operational Alert Email
ALERT_NOTIFICATION_EMAIL=ops@assurance.local
